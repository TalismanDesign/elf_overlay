{
  "name": "elf_overlay",
  "version": "1.0.0",
  "description": "Universal, ISA-abstracted ELF overlay runtime library",
  "license": "Apache-2.0",
  "keywords": ["overlay", "elf", "xtensa", "riscv", "embedded"],
  "repository": {
    "type": "git",
    "url": "https://github.com/TalismanDesign/elf_overlay"
  },
  "authors": [
    {
      "name": "NellowTCS",
      "email": "nellowtcs@gmail.com",
      "url": "https://github.com/NellowTCS",
      "maintainer": true
    },
    {
      "name": "Ashtf",
      "url": "https://github.com/ashtf8",
      "maintainer": true
    }
  ],
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": [
    "espressif32"
  ],
  "dependencies": {
    "elf_loader": "*"
  },
  "export": {
    "include": [
      "src",
      "include",
      "tools",
      "examples",
      "CMakeLists.txt",
      "idf_component.yml",
      "library.json",
      "README.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "LICENSE"
    ],
    "exclude": [
      "examples/*/build",
      "examples/*/managed_components",
      "examples/*/sdkconfig",
      "examples/*/dependencies.lock"
    ]
  },
  "build": {
    "srcFilter": [
      "+<*>",
      "-<tools/>",
      "-<tests/>",
      "-<examples/>",
      "-<build/>"
    ],
    "flags": [
      "-DELF_OVERLAY_ESP_IDF=1"
    ]
  }
}
